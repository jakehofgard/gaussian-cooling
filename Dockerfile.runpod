FROM python:3.12-slim-bookworm

ARG JAX_VERSION=0.11.0
ARG JAX_CUDA_EXTRA=cuda13
ARG GC_GIT_SHA=unknown
ARG GC_IMAGE_REF=unknown

LABEL org.opencontainers.image.title="gaussian-cooling"
LABEL org.opencontainers.image.revision="${GC_GIT_SHA}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    GC_REPO=/opt/gaussian-cooling \
    GC_GIT_SHA="${GC_GIT_SHA}" \
    GC_IMAGE_REF="${GC_IMAGE_REF}"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends bash ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/gaussian-cooling

COPY requirements.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip wheel \
    && python -m pip install --no-cache-dir \
        -r requirements.txt "jax[${JAX_CUDA_EXTRA}]==${JAX_VERSION}" \
    && python -m pip check

COPY gaussian_cooling_algs.py ./
COPY experiment_transformed_gaussian.py ./
COPY experiment_truncated_phi4.py ./
COPY README.md RUNPOD.md ./

CMD ["bash"]
